{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "org.jetbrains.kotlin.plugin.compose"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "com.android.application:com.android.application.gradle.plugin"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "matsudamper/actions"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "/^actions\\//"
      ],
      "automerge": true
    }
  ]
}
